<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.transactionlab.cache.ProductMapper">
    <select id="findById" resultType="com.example.transactionlab.cache.ProductRecord">
        SELECT product_id, status
        FROM products
        WHERE product_id = #{productId}
    </select>
</mapper>
