<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.transactionlab.mybatis.OrderMapper">
    <insert id="insert" parameterType="com.example.transactionlab.mybatis.OrderRecord">
        INSERT INTO orders (order_id, status)
        VALUES (#{orderId}, #{status})
    </insert>
    <select id="countById" resultType="int">
        SELECT COUNT(*) FROM orders WHERE order_id = #{orderId}
    </select>
</mapper>
