<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.transactionlab.selectone.CustomerOrderMapper">
    <select id="findLatestByCustomerId" resultType="com.example.transactionlab.selectone.CustomerOrder">
        SELECT order_id, customer_id, created_at, total_amount
        FROM customer_orders
        WHERE customer_id = #{customerId}
        ORDER BY created_at DESC
    </select>
</mapper>
