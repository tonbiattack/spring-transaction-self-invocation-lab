<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.transactionlab.mapping.InventoryItemMapper">
    <select id="findById" resultType="com.example.transactionlab.mapping.InventoryItem">
        SELECT item_id AS itemId, display_name AS displayName
        FROM inventory_items
        WHERE item_id = #{itemId}
    </select>
</mapper>
